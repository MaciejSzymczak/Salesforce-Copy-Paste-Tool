   <tr>
   <td>
        <div class="slds-form-element">
          <label class="slds-form-element__label" for="year">Year</label>
          <div class="slds-form-element__control">
            <select id="year" class="slds-select" style="width: 110px;" onchange="refresh();"></select>
          </div>
        </div>
   </td>
   <td style="padding-left: 4px;">
        <div class="slds-form-element">
          <label class="slds-form-element__label" for="status">Status</label>
          <div class="slds-form-element__control">
            <select id="status" class="slds-select" style="width: 140px;" onchange="refresh();"></select>
          </div>
        </div>
   </td>
   <td style="padding-left: 4px;">
        <div class="slds-form-element">
          <label class="slds-form-element__label" for="groupBy">Show per</label>
          <div class="slds-form-element__control">
            <select id="groupBy" class="slds-select" style="width: 170px;" onchange="groupByChanged();">
              <option value="sender" selected="selected">Sender</option>
              <option value="doc">Original document</option>
              <option value="object">Object</option>
              <option value="year">Year</option>
              <option value="status">Status</option>
            </select>
          </div>
        </div>
   </td>
   <td style="padding-left: 4px;">
        <div class="slds-form-element">
          <label class="slds-form-element__label" for="chartType">Chart</label>
          <div class="slds-form-element__control">
            <select id="chartType" class="slds-select" style="width: 120px;" onchange="render();">
              <option value="pie" selected="selected">Circle (pie)</option>
              <option value="donut">Donut</option>
              <option value="bars">Bars</option>
              <option value="bubbles">Bubbles</option>
            </select>
          </div>
        </div>
   </td>
   <td style="vertical-align: bottom; padding-left: 4px;">
        <button class="slds-button slds-button_neutral" onclick="javascript:refresh();">Refresh</button>
   </td>
   <td style="vertical-align: bottom; padding-left: 4px;">
        <button class="slds-button slds-button_neutral" onclick="javascript:downloadText();">Download</button>
   </td>
   <td style="vertical-align: bottom; padding-left: 4px;">
        <button class="slds-button slds-button_neutral" onclick="javascript:toggleSOQL();">Show SOQL</button>
   </td>
   </tr>
   </table>

</div>
<div class="slds-text-body_small">&nbsp;</div>

<div id="divSOQL" class="ct-soql" style="display: none;"></div>
<div id="divSummary" class="slds-text-body_regular" style="margin: 5px; text-align: center;">Loading...</div>
<div id="divChart" style="margin: 5px;"></div>

<script>
        try {
            loadPicklists();
            refresh();
        } catch(err) {
