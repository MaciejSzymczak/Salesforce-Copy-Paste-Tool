    <script>

        String.prototype.format = function() {
          var args = arguments;
          return this.replace(/{(\d+)}/g, function(match, number)
          {
            return typeof args[number] != 'undefined' ? args[number] :
                                                        '{' + number + '}';
          });
        };

        itemsToHide = ['type'];
        fineLabels = {"OldValue":"NewValue"};
        fieldSeparator = '';
        
        function flattenJSON(data) {
            let result = [];

            data.forEach(item => {
                let flatItem = {};
                flattenHelper(item, flatItem, '');
                result.push(flatItem);
            });

            return result;
        }

        function flattenHelper(current, flatItem, prefix) {
            for (let key in current) {
                if (current.hasOwnProperty(key)) {
                    let value = current[key];
                    let newKey = prefix ? `${prefix}.${key}` : key;

                    if (value && typeof value === 'object' && !Array.isArray(value)) {
                        flattenHelper(value, flatItem, newKey);
                    } else {
                        flatItem[newKey] = value;
                    }
                }
            }
        }

        //drop the columns that are NULL (or empty) in every record; the records are copied, not changed
        function removeNullColumns(records) {
            if (!Array.isArray(records) || records.length == 0 || typeof(records[0]) != 'object') return records;
            var filled = {};
            for (var i = 0; i < records.length; i++) {
                for (var key in records[i]) {
                    var value = records[i][key];
                    if (value !== null && value !== undefined && value !== '') filled[key] = true;
                }
            }
            var result = [];
            for (var r = 0; r < records.length; r++) {
                var row = {};
                for (var k in records[r]) {
                    if (filled[k]) row[k] = records[r][k];
                }
                result.push(row);
            }
            return result;
        }

        //swap rows and columns: one row per field, one column per record
        function transposeRecordset(records) {
            if (!records || records.length == 0) return records;
            var headers = array_keys(records[0]);
            var transposed = [];
            for (var h = 0; h < headers.length; h++) {
                var row = {};
                row['Field'] = headers[h];
                for (var i = 0; i < records.length; i++) {
                    row['Record ' + (i+1)] = records[i][headers[h]];
                }
                transposed.push(row);
            }
            return transposed;
        }

        /**
         * @author Maciej Szymczak, based on Json-to-HTML-Table-master by Afshin Mehrabani
         */
        var rowCount;
        function ConvertJsonToTable(xparsedJson, tableId, tableClassName, linkText, csvMode,recurrence,editable)
        {
            rowCount = 0;
            //Patterns for links and NULL value
            var italic = '<i>{0}</i>';
            var link = linkText ? '<a href="{0}">' + linkText + '</a>' :
                                  '<a href="{0}">{0}</a>';

            //Pattern for table
            var idMarkup = tableId ? ' id="' + tableId + '"' :
                                     '';

            var classMarkup = tableClassName ? ' class="' + tableClassName + '"' :
                                               '';

            var tbl = '<table class="list" border="1" cellpadding="0" cellspacing="0"' + idMarkup + classMarkup + '>{0}{1}</table>';
            //Patterns for table content
            var th = '<thead>{0}</thead>';
            var tb = '<tbody>{0}</tbody>';
            var tr = '<tr class="dataRow">{0}</tr>';
            var thRow = '<th class="headerRow">{0}</th>';
            var tdRow = '<td class="dataCell">{0}</td>';
            //editable cells: only used for the plain (non-flattened, non-transposed) SOQL result grid
            var tdRowEditable = '<td class="dataCell editableCell" contenteditable="true" data-id="{1}" data-object="{2}" data-field="{3}">{0}</td>';
            //delete-row button: shown alongside editable cells, one per real sObject row
            var tdRowDelete = '<td class="dataCell"><button class="slds-button slds-button_destructive slds-button_small" type="button" onclick="javascript:deleteRecord(\'{0}\',\'{1}\');">Delete</button></td>';
            var thCon = '';
            var tbCon = '';
            var trCon = '';
            if (csvMode) {
                editable = false;
                italic = '{0}';
                tbl = '{0}{1}';
                //Patterns for table content
                th = '{0}';
                tb = '{0}';
                tr = '{0}'; 
                thRow = '"{0}"'+fieldSeparator;
                tdRow = '"{0}"'+fieldSeparator;
                thCon = '';
                tbCon = '';
                trCon = '';
            }

            //Maciej Szymczak: Process data even for single object (not a list)
            var opaqueObject = [];
            var parsedJson;
            if (typeof(xparsedJson[0])=='undefined') {
              opaqueObject.push(xparsedJson);
              parsedJson  = opaqueObject;
            }
            else
              parsedJson = xparsedJson;

            if (parsedJson)
            {
                var isStringArray = typeof(parsedJson[0]) == 'string';
                var headers;

                // Create table headers from JSON data
                // If JSON data is a simple string array we create a single table header
                if(isStringArray)
                    thCon += thRow.format('value');
                else
                {
                    // If JSON data is an object array, headers are automatically computed
                    if(typeof(parsedJson[0]) == 'object')
                    {
                        headers = array_keys(parsedJson[0]);
                        for ( key in itemsToHide ) {
                        index = headers.indexOf(itemsToHide[key]);
                        if (index!=-1) headers.splice(index,1);
                        }

                        for (i = 0; i < headers.length; i++) {
                           var fineLabel = fineLabels[headers[i]];
                           if (!fineLabel)
                               fineLabel = headers[i];
                           thCon += thRow.format(fineLabel);
                        }
                        if (editable) {
                            thCon += thRow.format('');
                        }
                    }
                }
                if (csvMode) thCon = thCon.substring(0, thCon.length - 1); //truncate last comma
                th = th.format(tr.format(thCon))+(recurrence?'':'\r\n');

                // Create table rows from Json data
                if(isStringArray)
                {
                    for (var i = 0; i < parsedJson.length; i++)
                    {
                        tbCon += tdRow.format(parsedJson[i]);
                        if (csvMode) tbCon = tbCon.substring(0, tbCon.length - 1); //truncate last comma
                        trCon += tr.format(tbCon)+(recurrence?'':'\r\n');
                        rowCount++;
                        tbCon = '';
                    }
                }
                else
                {
                    if(headers)
                    {
                        var urlRegExp = new RegExp(/(\b(https?|ftp|file):\/\/[-A-Z0-9+&@#\/%?=~_|!:,.;]*[-A-Z0-9+&@#\/%=~_|])/ig);
                        var javascriptRegExp = new RegExp(/(^javascript:[\s\S]*;$)/ig);

                        //Maciej Szymczak: missing var added
                        for (var i = 0; i < parsedJson.length; i++)
                        {
                            //a row is editable only if it's a real queried sObject (has Id + the hidden 'type' attribute)
                            var rowRecord = parsedJson[i];
                            var rowIsEditable = editable && rowRecord && rowRecord.Id && rowRecord.type;

                            //Maciej Szymczak: missing var added
                            for (var j = 0; j < headers.length; j++)
                            {
                                try {
                                var value = rowRecord[headers[j]];

                                var isUrl = urlRegExp.test(value) || javascriptRegExp.test(value);
                                //Id is the primary key and relationship/subquery columns are objects - never editable.
                                //Note: typeof null === 'object' in JS, so a plain "typeof(value) != 'object'" check
                                //would also wrongly exclude NULL scalar field values - explicitly allow null through.
                                var cellIsEditable = rowIsEditable && headers[j] !== 'Id' && (value === null || typeof(value) != 'object');

                                if(isUrl)   // If value is URL we auto-create a link
                                    tbCon += tdRow.format(link.format(value));
                                else
                                {
                                    if(value){
                                        if(typeof(value) == 'object'){
                                            //for supporting nested tables
                                            //Maciej Szymczak: I deleted value.data as it was not generic thing
                                            tbCon += tdRow.format(ConvertJsonToTable(value,'','','',csvMode,true));
                                        } else if (cellIsEditable) {
                                            tbCon += tdRowEditable.format(value, rowRecord.Id, rowRecord.type, headers[j]);
                                        } else {
                                            tbCon += tdRow.format(value);
                                        }

                                    } else if (cellIsEditable) {
                                        tbCon += tdRowEditable.format('', rowRecord.Id, rowRecord.type, headers[j]);
                                    } else {    // If value == null we format it like PhpMyAdmin NULL values
                                        tbCon += tdRow.format(italic.format(value).toUpperCase());
                                    }
                                }
                                } catch(err) {
                                    //tbCon += tdRow.format("error:"+headers[j]+" "+parsedJson);
                                }
                            }
                            if (editable) {
                                tbCon += rowIsEditable ? tdRowDelete.format(rowRecord.Id, rowRecord.type) : tdRow.format('');
                            }
                            if (csvMode) tbCon = tbCon.substring(0, tbCon.length - 1); //truncate last comma
                            trCon += tr.format(tbCon)+(recurrence?'':'\r\n');
                            rowCount++;
                            tbCon = '';

                        }
                    }
                }
                tb = tb.format(trCon);
                tbl = tbl.format(th, tb);

                return tbl;
            }
            return null;
        }

        function array_keys(input, search_value, argStrict)
        {
            var search = typeof search_value !== 'undefined', tmp_arr = [], strict = !!argStrict, include = true, key = '';

            if (input && typeof input === 'object' && input.change_key_case) { // Duck-type check for our own array()-created PHPJS_Array
                return input.keys(search_value, argStrict);
            }

            for (key in input)
            {
                if (input.hasOwnProperty(key))
                {
                    include = true;
                    if (search)
                    {
                        if (strict && input[key] !== search_value)
                            include = false;
                        else if (input[key] != search_value)
                            include = false;
                    }
                    if (include)
                        tmp_arr[tmp_arr.length] = key;
                }
            }
            return tmp_arr;
        }

