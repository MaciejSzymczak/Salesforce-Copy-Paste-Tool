    <script>
        sforce.connection.sessionId = "{!$Api.Session_ID}";
        function download(data, filename, type) {
        var a = document.createElement("a"),
            file = new Blob([data], {type: type});
        if (window.navigator.msSaveOrOpenBlob) // IE10+
            window.navigator.msSaveOrOpenBlob(file, filename);
        else { // Others
            var url = URL.createObjectURL(file);
            a.href = url;
            a.download = filename;
            document.body.appendChild(a);
            a.click();
            setTimeout(function() {
                document.body.removeChild(a);
                window.URL.revokeObjectURL(url);  
            }, 0); 
        }
        }
        
        function isSalesforceId(value) {
            return /^[a-zA-Z0-9]{15}$|^[a-zA-Z0-9]{18}$/.test(value);
        }

        function getObjectNameFromKeyPrefix(prefix) {
            var dg = sforce.connection.describeGlobal();
            for (var i = 0; i < dg.sobjects.length; i++) {
                if (dg.sobjects[i].keyPrefix == prefix) {
                    return dg.sobjects[i].name;
                }
            }
            return null;
        }

        function getCommaSeparatedFields (objectName, creatableOnly, customFieldsOnly) {
            commaSeparatedFields = '';
            descObject=sforce.connection.describeSObjects([objectName]);
            for (cnt in descObject[0].fields) {
              console.log('LOG:'+descObject[0].fields[cnt].name + '    '+ descObject[0].fields[cnt].custom);
              if (creatableOnly) if (descObject[0].fields[cnt].createable=='false') continue;
              if (customFieldsOnly) if (descObject[0].fields[cnt].custom=='false') { console.log('NOT CUSTOM:'+descObject[0].fields[cnt].name);  continue; }
              commaSeparatedFields = commaSeparatedFields + descObject[0].fields[cnt].name + ',';
            }
            return commaSeparatedFields.substring(0,commaSeparatedFields.length-1);
        }

        function generateURL(textareaId) {
                var URL = '/apex/SOQLExplorer?header=Report&q='+encodeURIComponent(GetSelection(textareaId))+'&flatView='+(document.getElementById('flatView').checked?'true':'false')+'&showNulls='+(document.getElementById('showNulls').checked?'true':'false');
                window.open(URL);
        }

        function showSpinner() {
            document.getElementById('runSpinner').style.display = 'block';
        }

        function hideSpinner() {
            document.getElementById('runSpinner').style.display = 'none';
        }

        //the recordset from the last SOQL query, kept so Flat view/Transpose result can re-render it without re-running the query
        var lastRecordset = null;
        //Tooling API records aren't SOAP sObjects, so the inline-edit/save path (which relies on sforce.connection.update()) is disabled for them
        var lastQueryWasTooling = false;

        function refreshResultView() {
            if (!lastRecordset) return;
            resetGridEdits();
            clearGridSelection();
            var flatView = document.getElementById('flatView').checked;
            var transposeView = document.getElementById('transposeView').checked;
            var dataForTable = flatView ? flattenJSON(lastRecordset) : lastRecordset;
            if (!document.getElementById('showNulls').checked) {
                dataForTable = removeNullColumns(dataForTable);
            }
            if (transposeView) {
                dataForTable = transposeRecordset(dataForTable);
            }
            var editable = !flatView && !transposeView && !lastQueryWasTooling;
            var data = ConvertJsonToTable(dataForTable, flatView ? 'selectableGrid' : '', '', '', false, false, editable);
            document.getElementById('divDescribeGlobal').innerHTML = data + '<br/>Count:' + lastRecordset.length;
        }

        //queries the Tooling API (for objects like ApexClass/ApexTrigger/... that aren't queryable via the normal SOAP API)
        async function queryToolingApi(soql) {
            var records = [];
            var url = '/services/data/v60.0/tooling/query?q=' + encodeURIComponent(soql);
            while (url) {
                var response = await fetch(url, { headers: { 'Authorization': 'Bearer ' + sforce.connection.sessionId } });
                var body = await response.json();
                if (Array.isArray(body) && body.length && body[0].errorCode) {
                    throw new Error(body[0].message || 'Tooling API query failed');
                }
                records = records.concat(body.records || []);
                url = body.nextRecordsUrl || null;
            }
            //normalize the REST shape (attributes.type) to the flat .type property the grid/itemsToHide logic expects
            for (var i = 0; i < records.length; i++) {
                if (records[i].attributes && records[i].attributes.type) {
                    records[i].type = records[i].attributes.type;
                }
                delete records[i].attributes;
            }
            return records;
        }

        //--- inline grid editing (plain SOQL result grid only - not flat view/transpose, not other views) ---

        var pendingEdits = {};

        function handleCellEdit(event) {
            var cell = event.target;
            if (!cell.classList || !cell.classList.contains('editableCell')) return;
            var key = cell.dataset.id + '|' + cell.dataset.field;
            pendingEdits[key] = { id: cell.dataset.id, object: cell.dataset.object, field: cell.dataset.field, value: cell.textContent };
            cell.classList.remove('cellSaved', 'cellError');
            cell.classList.add('cellDirty');
            updateGridEditBar();
        }

        function updateGridEditBar() {
            var keys = Object.keys(pendingEdits);
            var bar = document.getElementById('gridEditBar');
            if (keys.length > 0) {
                document.getElementById('gridEditCount').textContent = keys.length + ' unsaved change' + (keys.length > 1 ? 's' : '') + '.';
                bar.style.display = 'block';
            } else {
                bar.style.display = 'none';
            }
        }

        function resetGridEdits() {
            pendingEdits = {};
            var bar = document.getElementById('gridEditBar');
            if (bar) bar.style.display = 'none';
            var errorEl = document.getElementById('gridEditError');
            if (errorEl) errorEl.textContent = '';
        }

        function discardGridEdits() {
            resetGridEdits();
            refreshResultView();
        }

        function saveGridEdits() {
            var keys = Object.keys(pendingEdits);
            if (keys.length === 0) return;

            //group edited fields per record per object type into real sforce.SObject instances -
            //sforce.connection.update() needs proper SObjects (built via new sforce.SObject()+.set()),
            //plain object literals are silently rejected (see the working pattern in PasteTool.page)
            var recordsByType = {};
            for (var k = 0; k < keys.length; k++) {
                var edit = pendingEdits[keys[k]];
                if (!recordsByType[edit.object]) recordsByType[edit.object] = {};
                if (!recordsByType[edit.object][edit.id]) {
                    var sobj = new sforce.SObject(edit.object);
                    sobj.set('Id', edit.id);
                    recordsByType[edit.object][edit.id] = sobj;
                }
                recordsByType[edit.object][edit.id].set(edit.field, edit.value);
            }

            showSpinner();
            try {
                var resultsById = {};
                for (var objectType in recordsByType) {
                    if (!recordsByType.hasOwnProperty(objectType)) continue;
                    var records = [];
                    var recordIds = [];
                    for (var recId in recordsByType[objectType]) {
                        if (recordsByType[objectType].hasOwnProperty(recId)) {
                            records.push(recordsByType[objectType][recId]);
                            recordIds.push(recId);
                        }
                    }
                    var saveResults = sforce.connection.update(records);
                    for (var i = 0; i < records.length; i++) {
                        resultsById[recordIds[i]] = saveResults[i];
                    }
                }

                var errorMessages = [];
                for (var k2 = 0; k2 < keys.length; k2++) {
                    var edit2 = pendingEdits[keys[k2]];
                    var cell = document.querySelector('.editableCell[data-id="' + edit2.id + '"][data-field="' + edit2.field + '"]');
                    var result = resultsById[edit2.id];
                    var success = result && (result.success === true || result.success === 'true');
                    if (cell) {
                        cell.classList.remove('cellDirty');
                        cell.classList.add(success ? 'cellSaved' : 'cellError');
                        cell.title = success ? '' : (result && result.errors ? JSON.stringify(result.errors) : 'Save failed');
                    }
                    if (success) {
                        if (lastRecordset) {
                            for (var r = 0; r < lastRecordset.length; r++) {
                                if (lastRecordset[r].Id === edit2.id) {
                                    lastRecordset[r][edit2.field] = edit2.value;
                                    break;
                                }
                            }
                        }
                        delete pendingEdits[keys[k2]];
                    } else {
                        errorMessages.push(edit2.field + ': ' + (cell ? cell.title : 'Save failed'));
                    }
                }
                document.getElementById('gridEditError').textContent = errorMessages.join(' | ');
                updateGridEditBar();
            } catch (err) {
                document.getElementById('gridEditError').textContent = 'Save failed: ' + err;
            } finally {
                hideSpinner();
            }
        }

        //--- Excel-like cell selection (flat view only): click/drag selects cells, Shift+click extends the selection,
        //    a header click selects whole columns, Ctrl+C copies the selection as tab separated text (pastes into Excel) ---

        //row -1 is the header row; when the anchor or the focus is on the header, whole columns are selected
        var gridSelection = null;
        var gridSelecting = false;

        function selectableGrid() {
            return document.getElementById('selectableGrid');
        }

        function gridCellAt(event) {
            var grid = selectableGrid();
            var cell = (grid && event.target.closest) ? event.target.closest('td, th') : null;
            if (!cell || cell.closest('table') !== grid) return null;
            return { row: cell.parentNode.parentNode.tagName == 'THEAD' ? -1 : cell.parentNode.sectionRowIndex, col: cell.cellIndex };
        }

        function gridSelectionRect(grid) {
            var s = gridSelection;
            var columnMode = s.anchorRow == -1 || s.focusRow == -1;
            return {
                r1: columnMode ? -1 : Math.min(s.anchorRow, s.focusRow),
                r2: columnMode ? grid.tBodies[0].rows.length - 1 : Math.max(s.anchorRow, s.focusRow),
                c1: Math.min(s.anchorCol, s.focusCol),
                c2: Math.max(s.anchorCol, s.focusCol)
            };
        }

        function gridRow(grid, r) {
            return r == -1 ? grid.tHead.rows[0] : grid.tBodies[0].rows[r];
        }

        function paintGridSelection() {
            var selected = document.querySelectorAll('.cellSelected');
            for (var i = 0; i < selected.length; i++) selected[i].classList.remove('cellSelected');
            var grid = selectableGrid();
            if (!grid || !gridSelection) return;
            var rect = gridSelectionRect(grid);
            for (var r = rect.r1; r <= rect.r2; r++) {
                var tr = gridRow(grid, r);
                for (var c = rect.c1; c <= rect.c2; c++) {
                    if (tr && tr.cells[c]) tr.cells[c].classList.add('cellSelected');
                }
            }
        }

        function clearGridSelection() {
            gridSelection = null;
            gridSelecting = false;
            paintGridSelection();
        }

        function gridCellValue(cell) {
            //NULL values are rendered as <i>NULL</i> - copy them as empty cells
            if (cell.firstChild && cell.firstChild.tagName == 'I' && cell.textContent == 'NULL') return '';
            var text = cell.textContent;
            //quote like Excel does when the value has a tab, a line break or a quote
            if (/[\t\r\n"]/.test(text)) text = '"' + text.replace(/"/g, '""') + '"';
            return text;
        }

        function gridSelectionText(grid) {
            var rect = gridSelectionRect(grid);
            var lines = [];
            for (var r = rect.r1; r <= rect.r2; r++) {
                var tr = gridRow(grid, r);
                var values = [];
                for (var c = rect.c1; c <= rect.c2; c++) {
                    values.push(tr && tr.cells[c] ? gridCellValue(tr.cells[c]) : '');
                }
                lines.push(values.join('\t'));
            }
            return lines.join('\r\n');
        }

        function handleGridMouseDown(event) {
            if (event.button != 0) return;
            var pos = gridCellAt(event);
            if (!pos) {
                if (gridSelection) clearGridSelection();
                return;
            }
            if (event.target.closest('a')) return; //let links open
            if (event.shiftKey && gridSelection) {
                gridSelection.focusRow = pos.row;
                gridSelection.focusCol = pos.col;
            } else {
                gridSelection = { anchorRow: pos.row, anchorCol: pos.col, focusRow: pos.row, focusCol: pos.col };
            }
            gridSelecting = true;
            //no text selection while dragging; move the focus away from the SOQL textarea so Ctrl+C copies the cells
            event.preventDefault();
            if (document.activeElement && document.activeElement.blur) document.activeElement.blur();
            if (window.getSelection) window.getSelection().removeAllRanges();
            paintGridSelection();
        }

        function handleGridMouseOver(event) {
            if (!gridSelecting || !gridSelection) return;
            var pos = gridCellAt(event);
            if (!pos || (pos.row == gridSelection.focusRow && pos.col == gridSelection.focusCol)) return;
            gridSelection.focusRow = pos.row;
            gridSelection.focusCol = pos.col;
            paintGridSelection();
        }

        function handleGridCopy(event) {
            var grid = selectableGrid();
            if (!grid || !gridSelection) return;
            var active = document.activeElement;
            if (active && (active.tagName == 'TEXTAREA' || active.tagName == 'INPUT' || active.tagName == 'SELECT')) return;
            event.clipboardData.setData('text/plain', gridSelectionText(grid));
            event.preventDefault();
        }

        //--- anonymous Apex: executeAnonymous of the SOAP Apex API, called like connection.js calls the SOAP API (no Apex controller) ---

        //builds an XML element; the tags are concatenated so the Visualforce parser does not read them as markup
        function xmlElement(name, content, attributes) {
            return '<' + name + (attributes ? ' ' + attributes : '') + '>' + content + '<' + '/' + name + '>';
        }

        function xmlValue(doc, name) {
            var nodes = doc.getElementsByTagNameNS('*', name);
            return nodes.length ? nodes[0].textContent : '';
        }

        //text that is not JSON, not a SOQL query and not a record Id is anonymous Apex
        function isApexCode(text) {
            text = text.trim();
            var isJson = text[0] == '[' || text[0] == '{';
            var isSoql = text.toLowerCase().startsWith('select');
            return text != '' && !isJson && !isSoql && !isSalesforceId(text);
        }

        //Run: the selection is executed as anonymous Apex when it is not JSON, a SOQL query or a record Id
        function RunClick(textareaId) {
            if (isApexCode(GetSelection(textareaId))) {
                ExecuteApexClick(textareaId);
            } else {
                downloadMySOQL(textareaId, 'nodownload');
            }
        }

        //executes the selected code (the whole editor when nothing is selected), like Run
        function ExecuteApexClick(textareaId) {
            executeAnonymousApex(GetSelection(textareaId));
        }

        function executeAnonymousApex(code) {
            var apexNs = 'xmlns="http://soap.sforce.com/2006/08/apex"';
            var envelope = xmlElement('soapenv:Envelope',
                xmlElement('soapenv:Header',
                    xmlElement('DebuggingHeader',
                        xmlElement('categories', xmlElement('category', 'Apex_code') + xmlElement('level', 'DEBUG'))
                        + xmlElement('debugLevel', 'DEBUGONLY'), apexNs)
                    + xmlElement('SessionHeader', xmlElement('sessionId', sforce.connection.sessionId), apexNs))
                + xmlElement('soapenv:Body',
                    xmlElement('executeAnonymous', xmlElement('String', escapeHtml(code)), apexNs)),
                'xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/"');

            showSpinner();
            fetch('/services/Soap/s/60.0', {
                    method: 'POST',
                    headers: { 'Content-Type': 'text/xml; charset=UTF-8', 'SOAPAction': '""' },
                    body: envelope
                })
                .then(function(response) { return response.text(); })
                .then(function(text) { showApexResult(new DOMParser().parseFromString(text, 'text/xml')); })
                .catch(function(err) {
                    document.getElementById('divDescribeGlobal').innerHTML = escapeHtml('Execute Apex failed: ' + err);
                })
                .finally(function() {
                    hideSpinner();
                });
        }

        function showApexResult(doc) {
            var html;
            var fault = xmlValue(doc, 'faultstring');
            if (fault) {
                html = '<p style="color:#b00020;">' + escapeHtml(fault) + '</p>';
            } else if (xmlValue(doc, 'compiled') != 'true') {
                //line/column count from the first line of the selected code
                html = '<p style="color:#b00020;">Compile error at line ' + xmlValue(doc, 'line') + ', column ' + xmlValue(doc, 'column')
                    + ': ' + escapeHtml(xmlValue(doc, 'compileProblem')) + '</p>';
            } else if (xmlValue(doc, 'success') != 'true') {
                html = '<p style="color:#b00020;">' + escapeHtml(xmlValue(doc, 'exceptionMessage')) + '</p>'
                    + '<pre>' + escapeHtml(xmlValue(doc, 'exceptionStackTrace')) + '</pre>';
            } else {
                html = '<p style="color:#2e844a;">Executed successfully.</p>';
            }
            var log = xmlValue(doc, 'debugLog');
            if (log) {
                var debugLines = log.split('\n').filter(function(line) { return line.indexOf('|USER_DEBUG|') != -1; });
                if (debugLines.length) {
                    html += '<p style="margin-top:8px;"><b>System.debug</b></p><pre>' + escapeHtml(debugLines.join('\n')) + '</pre>';
                }
                html += '<details style="margin-top:8px;"><summary>Debug log</summary><pre>' + escapeHtml(log) + '</pre></details>';
            }
            //the result is not a recordset: Flat view/Transpose/Show nulls must not re-render the previous query over it
            lastRecordset = null;
            resetGridEdits();
            clearGridSelection();
            document.getElementById('divDescribeGlobal').innerHTML = html;
        }

        function deleteRecord(id, type) {
            if (!confirm('Delete this ' + type + ' record (' + id + ')? This cannot be undone.')) return;
            showSpinner();
            try {
                var results = sforce.connection.deleteIds([id]);
                var result = results[0];
                var success = result && (result.success === true || result.success === 'true');
                if (success) {
                    if (lastRecordset) {
                        lastRecordset = lastRecordset.filter(function(r) { return r.Id !== id; });
                    }
                    refreshResultView();
                } else {
                    alert('Delete failed: ' + (result && result.errors ? JSON.stringify(result.errors) : 'Unknown error'));
                }
            } catch (err) {
                alert('Delete failed: ' + err);
            } finally {
                hideSpinner();
            }
        }

        function downloadMySOQL(textareaId, pfieldSeparator) {
            showSpinner();
            setTimeout(async function() {
            try {
                var mySOQL = GetSelection(textareaId);

                //if the user typed/selected a bare Salesforce ID, turn it into 'select * from <Object> where id = ...'
                var trimmedSOQL = mySOQL.trim();
                if (isSalesforceId(trimmedSOQL)) {
                    var objectName = getObjectNameFromKeyPrefix(trimmedSOQL.substring(0,3));
                    if (objectName) {
                        mySOQL = "select * from " + objectName + " where id = '" + trimmedSOQL + "'";
                        ModifySelection(textareaId, mySOQL);
                    }
                }

                //replace 'select * from contact' with 'select <column names> from contact'
                if (mySOQL.toLowerCase().startsWith('select * from')) {
                    var fromStr = mySOQL.substring(14,65000)+' ';
                    var n = fromStr.indexOf(" ");
                    var objectName = fromStr.substring(0,n);
                    var restSOQL = fromStr.substring(n,65000);
                    if (restSOQL.toLowerCase().indexOf('limit')==-1) {
                        restSOQL = restSOQL + 'limit 200';
                    }
                    mySOQL = 'select ' + getCommaSeparatedFields(objectName, false, false) + ' from ' + objectName+ restSOQL;
                    //ModifySelection(textareaId, mySOQL);
                }
                
                var toolingApi = document.getElementById('toolingApi').checked;

                myJsonString = '';
                //check if the string is either SOQL or JSON
                if (mySOQL[0] == "[" || mySOQL[0] == "{" ) {
                  myJsonString = mySOQL;
                } else if (toolingApi) {
                  myJsonString = JSON.stringify(await queryToolingApi(mySOQL));
                } else {
                  var records=[];
                  var result = sforce.connection.query(mySOQL);
                  var queryMore = true;
                  while (queryMore) {
                      var recordsChunk = result.getArray("records");
                      records = records.concat(recordsChunk);
                      if (result.getBoolean("done")) {
                          queryMore = false;
                      } else {
                          result = sforce.connection.queryMore(result.queryLocator);
                      }
                  }
                  myJsonString = JSON.stringify(records);
                }

                recordset = JSON.parse(myJsonString);
                lastRecordset = recordset;
                lastQueryWasTooling = toolingApi;
                //print (recordset);
                fieldSeparator = pfieldSeparator;
                data = ConvertJsonToTable (recordset,'','','',true);
                filename = 'dummy.txt';
                type = 'text/plain';
                
                if (pfieldSeparator=='JSON') {
                    data = myJsonString;
                }
                if (pfieldSeparator=='nodownload') {
                    resetGridEdits();
                    clearGridSelection();
                    var flatView = document.getElementById('flatView').checked;
                    var transposeView = document.getElementById('transposeView').checked;
                    var dataForTable = flatView ? flattenJSON(recordset) : recordset;
                    if (!document.getElementById('showNulls').checked) {
                        dataForTable = removeNullColumns(dataForTable);
                    }
                    if (transposeView) {
                        dataForTable = transposeRecordset(dataForTable);
                    }
                    var editableGrid = !flatView && !transposeView && !toolingApi;
                    data = ConvertJsonToTable ( dataForTable, flatView ? 'selectableGrid' : '', '', '', false, false, editableGrid );
                }

                if (pfieldSeparator!='nodownload') {
                  download(data, filename, type);
                }
                document.getElementById('divDescribeGlobal').innerHTML = data + '<br/>Count:'+recordset.length;
                }
            catch(err)
            {
                document.getElementById('divDescribeGlobal').innerHTML = err;
            }
            finally
            {
                hideSpinner();
            }
            }, 10);
        }

        function userInfo() {
            var dg = sforce.connection.getUserInfo();
            document.getElementById('divDescribeGlobal').innerHTML = '<div class="datagrid">'+ConvertJsonToTable(dg)+'</div>';
        }

        function showOrgLimits() {
            showSpinner();
            fetch('/services/data/v60.0/limits', { headers: { 'Authorization': 'Bearer ' + sforce.connection.sessionId } })
                .then(function(response) { return response.json(); })
                .then(function(limits) {
                    var rows = [];
                    for (var key in limits) {
                        if (limits.hasOwnProperty(key)) {
                            rows.push({ Limit: key, Max: limits[key].Max, Remaining: limits[key].Remaining });
                        }
                    }
                    document.getElementById('divDescribeGlobal').innerHTML = '<div class="datagrid">'+ConvertJsonToTable(rows)+'</div>';
                })
                .catch(function(err) {
                    document.getElementById('divDescribeGlobal').innerHTML = err;
                })
                .finally(function() {
                    hideSpinner();
                });
        }

        function clearResults() {
            document.getElementById('divDescribeGlobal').innerHTML = '';
        }

        function showAboutDialog() {
            document.getElementById('aboutModal').style.display = 'block';
        }

        function hideAboutDialog() {
            document.getElementById('aboutModal').style.display = 'none';
        }

        function showQuickGuideDialog() {
            document.getElementById('quickGuideModal').style.display = 'block';
        }

        function hideQuickGuideDialog() {
            document.getElementById('quickGuideModal').style.display = 'none';
        }

        function showAllObjectsPicklist(button) {
            var input = document.getElementById('objectName');
            var dg = sforce.connection.describeGlobal();

            if (input.tagName.toLowerCase() !== 'select') {
                var currentValue = input.value;
                var names = [];
                for (var i = 0; i < dg.sobjects.length; i++) {
                    names.push(dg.sobjects[i].name);
                }
                names.sort();

                var select = document.createElement('select');
                select.id = 'objectName';
                for (var j = 0; j < names.length; j++) {
                    var option = document.createElement('option');
                    option.value = names[j];
                    option.textContent = names[j];
                    if (names[j] === currentValue) option.selected = true;
                    select.appendChild(option);
                }
                input.parentNode.replaceChild(select, input);
            }

            resetGridEdits();
            document.getElementById('divDescribeGlobal').innerHTML = '<div class="datagrid">'+ConvertJsonToTable(dg.sobjects)+'</div>';
        }


        function describeObject () {
            objectName=document.getElementById('objectName').value.trim();
            var res= sforce.connection.describeSObjects([objectName]);
            document.getElementById('divDescribeGlobal').innerHTML = '<div class="datagrid">'+ConvertJsonToTable(res)+'</div>';
        }

        function describeObjectFields () {
            objectName=document.getElementById('objectName').value.trim();
            var res= (sforce.connection.describeSObjects([objectName]))[0].fields;    
            document.getElementById('divDescribeGlobal').innerHTML = '<div class="datagrid">'+ConvertJsonToTable(res)+'</div>';
        }
        
        function childRelationships () {
            objectName=document.getElementById('objectName').value.trim();
            var res= (sforce.connection.describeSObjects([objectName]))[0].childRelationships;    
            document.getElementById('divDescribeGlobal').innerHTML = '<div class="datagrid">'+ConvertJsonToTable(res)+'</div>';
        }
        
        function recordTypeInfos () {
            objectName=document.getElementById('objectName').value.trim();
            var res= (sforce.connection.describeSObjects([objectName]))[0].recordTypeInfos;    
            document.getElementById('divDescribeGlobal').innerHTML = '<div class="datagrid">'+ConvertJsonToTable(res)+'</div>';
        }
        
        
        function CommaSeparatedFields (creatableOnly, customFieldsOnly) {
            objectName=document.getElementById('objectName').value.trim();
            var res= getCommaSeparatedFields(objectName, creatableOnly, customFieldsOnly);    
            document.getElementById('divDescribeGlobal').innerHTML = '<div class="datagrid">select '+res+' from '+document.getElementById('objectName').value+'</div>';
        }
        
        function openInNewTab(url) {
          var win = window.open(url, '_blank');
          win.focus();
        }

        function closePage() {
          //this page is typically opened embedded in a Lightning Experience iframe; navigating
          //window.location (the iframe) to the my.salesforce.com home page gets blocked by that
          //domain's X-Frame-Options ("refused to connect"), so navigate the top-level tab instead.
          window.top.location.href = '/home/home.jsp';
        }

        //unhides the SOQL textarea/toolbar when the page was opened with a 'header' param (which hides them)
        function showQueryEditor() {
            document.getElementById('SOQLExpEditor').style.display = '';
            document.getElementById('wrapper').style.display = '';
            document.getElementById('editButton').style.display = 'none';
            syncSOQLHighlight();
        }

function executeSelect() {
    switch (document.getElementById('select').selectedIndex)
        {
           case 1: describeObject(); break;
           case 2: describeObjectFields(); break;
           case 3: childRelationships(); break;
           case 4: CommaSeparatedFields(false,false); break;
           case 5: CommaSeparatedFields(true,false); break;
           case 6: CommaSeparatedFields(false,true); break;
           case 7: recordTypeInfos(); break;
           default: 
               alert('Default case'); break;
        }
    document.getElementById('select').selectedIndex = 0;    
}

function otherActions() {
    switch (document.getElementById('otherActions').selectedIndex)
        {
           case 1: openInNewTab('/soap/ajax/60.0/debugshell.html'); break;
           case 2: userInfo (); break;
           case 3: showOrgLimits(); break;
           case 4: clearResults(); break;

           //default:
           //    alert('Default case'); break;
        }
        document.getElementById('otherActions').selectedIndex = 0;
}

function moreActions() {
    switch (document.getElementById('moreActions').selectedIndex)
        {
           case 1: downloadMySOQL('SOQLExp',','); break;
           case 2: downloadMySOQL('SOQLExp',String.fromCharCode(9)); break;
           case 3: downloadMySOQL('SOQLExp','JSON'); break;
           case 4: generateURL('SOQLExp'); break;
        }
        document.getElementById('moreActions').selectedIndex = 0;
}


</script>


<body>
<div class="slds-scope">
    <div id="header" class="slds-notify slds-notify_alert slds-theme_alert-texture slds-theme_info" role="alert" style="position:relative;">
      <h2 id="headerText">SOQL Explorer</h2>
      <span style="position:absolute; right:8px; top:50%; transform:translateY(-50%);">
          <button class="slds-button slds-button_neutral" id="editButton" style="display:none;" onclick="javascript:showQueryEditor();">Edit</button>
          <button class="slds-button slds-button_neutral" onclick="javascript:closePage();">Close</button>
      </span>
    </div>
    
<div id="SOQLExpEditor">
<div id="SOQLHighlightBox"><pre id="SOQLHighlight" aria-hidden="true"></pre></div>
<textarea Id="SOQLExp" rows="10" cols="80" spellcheck="false" oninput="refreshSOQLHighlight();" onscroll="syncSOQLHighlight();">
Select the query and hit the button Run. The wildcard * is supported!

select * from RecordType order by CreatedDate desc limit 1000
select Id, FIELDS(CUSTOM) from Account order by CreatedDate desc limit 1
select Id, Name, userName, lastloginDate, createdDate, isActive from User where  isActive = true and Profile.UserLicense.Name = 'Salesforce' order by LastLoginDate desc, createdDate limit 100
select Id, Name, (select id, FirstName, LastName from Contacts limit 2) from Account limit 10
select Id, FirstName, LastName, (select Id from Tasks), account.owner.Name from Contact limit 2

--New accounts Y2Y
Select count(Id) Accounts, Calendar_Year(CreatedDate) Yearly from Account where CreatedDate = last_n_days:1500 group by Calendar_Year(CreatedDate) order by Calendar_Year(CreatedDate)

--Select this line and click button Run
system.debug('Testing apex execution:' + [select Id from Account limit 1]);

--Accounts by Owners
Select count(Id) Accounts, OwnerId, Owner.IsActive, Owner.Name, Owner.Profile.Name Profile from Account group by OwnerId, Owner.IsActive, Owner.Name, Owner.Profile.Name order by count(Id) desc

--Leads, Opportunities
select Id, Email, Country, Company, IsConverted, ConvertedContactId, ConvertedAccountId, ConvertedOpportunityId, ConvertedDate, Status, RecordType.Name  from Lead order by createdDate desc limit 100
select Id, Name, IsClosed, IsWon, Amount, PriceBook2Id, PriceBook2.Name  from Opportunity order by createdDate desc limit 100
select Id, OpportunityId, PriceBookEntryId, PriceBookEntry.Product2.Name  from OpportunityLineItem order by createdDate desc limit 100

--SetupAuditTrail
SELECT Action, CreatedById, CreatedDate, DelegateUser, Display, Id, Section 
FROM SetupAuditTrail 
WHERE CreatedBy.Name = 'Maciej Szymczak' AND CreatedDate = Last_n_Days:1
ORDER BY CreatedDate DESC NULLS FIRST LIMIT 1000

--Event log (logins, logouts etc within last 24 hours / 30 days)
