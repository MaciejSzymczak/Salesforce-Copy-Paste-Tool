<div id="divDescribeGlobal" style="margin: 5px;"></div>

<script>
    document.getElementById('divDescribeGlobal').addEventListener('input', handleCellEdit);
    document.addEventListener('mousedown', handleGridMouseDown);
    document.addEventListener('mouseover', handleGridMouseOver);
    document.addEventListener('mouseup', function() { gridSelecting = false; });
    document.addEventListener('copy', handleGridCopy);
    document.addEventListener('keydown', function(event) { if (event.key == 'Escape' && gridSelection) clearGridSelection(); });

    var url_string = window.location.href;
    var url = new URL(url_string);
    var flatView = url.searchParams.get("flatView");
    var q = url.searchParams.get("q");
    var header = url.searchParams.get("header");
    if (flatView != null) {
        document.getElementById('flatView').checked = (flatView=='true');
    }
    var showNulls = url.searchParams.get("showNulls");
    if (showNulls != null) {
        document.getElementById('showNulls').checked = (showNulls=='true');
    }
    if (q != null) {
        document.getElementById('SOQLExp').value = q;
        //a link must never execute code: Apex in the URL is shown, not executed
        if (isApexCode(q)) {
            document.getElementById('divDescribeGlobal').innerHTML =
                '<p style="color:#b00020;">Apex code is not allowed as parameter. Only a SOQL query or JSON can be passed in the URL (parameter q).</p>';
        } else {
            downloadMySOQL('SOQLExp','nodownload');
        }
    }
    refreshSOQLHighlight();
    if (window.ResizeObserver) new ResizeObserver(syncSOQLHighlight).observe(document.getElementById('SOQLExp'));
    window.addEventListener('resize', syncSOQLHighlight);
    if (header != null) {
        document.getElementById('SOQLExpEditor').style.display="none";
        document.getElementById('wrapper').style.display="none";
        document.getElementById('headerText').innerHTML = header;
        document.getElementById('editButton').style.display = "inline-block";
    }
</script>


