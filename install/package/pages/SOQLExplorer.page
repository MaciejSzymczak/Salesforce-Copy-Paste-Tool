    //--- SOQL syntax highlighting of the editor ---

    function wordSet(words) {
        var set = {};
        words.split(' ').forEach(function(w) { set[w] = true; });
        return set;
    }

    var SOQL_KEYWORDS = wordSet('SELECT FROM WHERE AND OR NOT IN INCLUDES EXCLUDES LIKE ORDER BY GROUP HAVING LIMIT OFFSET '
        + 'ASC DESC NULLS FIRST LAST WITH TYPEOF WHEN THEN ELSE END USING SCOPE FOR VIEW REFERENCE UPDATE TRACKING VIEWSTAT '
        + 'ROLLUP CUBE SECURITY_ENFORCED USER_MODE SYSTEM_MODE DATA CATEGORY AT ABOVE BELOW ABOVE_OR_BELOW ALL ROWS '
        + 'INSERT DELETE UPSERT UNDELETE MERGE'); //Apex DML for Execute Apex
    var SOQL_FUNCTIONS = wordSet('COUNT COUNT_DISTINCT SUM AVG MIN MAX CALENDAR_MONTH CALENDAR_QUARTER CALENDAR_YEAR '
        + 'DAY_IN_MONTH DAY_IN_WEEK DAY_IN_YEAR DAY_ONLY FISCAL_MONTH FISCAL_QUARTER FISCAL_YEAR HOUR_IN_DAY WEEK_IN_MONTH '
        + 'WEEK_IN_YEAR FIELDS TOLABEL FORMAT CONVERTCURRENCY CONVERTTIMEZONE GROUPING DISTANCE GEOLOCATION');
    //NULL, TRUE, FALSE and the date literals (TODAY, LAST_N_DAYS, THIS_FISCAL_YEAR, N_DAYS_AGO, ...)
    var SOQL_LITERAL = /^(NULL|TRUE|FALSE|YESTERDAY|TODAY|TOMORROW|(LAST|THIS|NEXT)_(WEEK|MONTH|QUARTER|YEAR|FISCAL_QUARTER|FISCAL_YEAR)|(LAST|NEXT)_90_DAYS|(LAST|NEXT)_N_[A-Z_]+|N_[A-Z_]+_AGO)$/;

    function escapeHtml(text) {
        //[<] instead of a bare < so the Visualforce parser does not read "</g" as a closing tag
        return text.replace(/&/g, '&amp;').replace(/[<]/g, '&lt;').replace(/[>]/g, '&gt;');
    }

    function highlightSOQL(text) {
        //1: --comment to the end of the line, 2: 'string', 3: number, 4: word
        var token = /(--[^\n]*)|('(?:\\.|[^'\\\n])*'?)|(\b\d+(?:\.\d+)?\b)|([A-Za-z_]\w*)/g;
        var html = '';
        var last = 0;
        var m;
        while ((m = token.exec(text)) !== null) {
            html += escapeHtml(text.substring(last, m.index));
            last = token.lastIndex;
            var cls = null;
            if (m[1]) cls = 'soqlComment';
            else if (m[2]) cls = 'soqlString';
            else if (m[3]) cls = 'soqlNumber';
            else {
                var word = m[4].toUpperCase();
                if (SOQL_LITERAL.test(word)) cls = 'soqlLiteral';
                else if (SOQL_KEYWORDS[word]) cls = 'soqlKeyword';
                else if (SOQL_FUNCTIONS[word] && /^\s*\(/.test(text.substring(last, last + 20))) cls = 'soqlFunction';
            }
            html += cls ? '<span class="' + cls + '">' + escapeHtml(m[0]) + '</span>' : escapeHtml(m[0]);
        }
        //the trailing newline keeps an empty last line as high as in the textarea
        return html + escapeHtml(text.substring(last)) + '\n';
    }

    //re-renders the highlighted copy; call it whenever the textarea value is changed from code
    function refreshSOQLHighlight() {
        document.getElementById('SOQLHighlight').innerHTML = highlightSOQL(document.getElementById('SOQLExp').value);
        syncSOQLHighlight();
    }

    //keeps the highlighted copy over the textarea content area (without its border and scrollbars) and scrolled like it
    function syncSOQLHighlight() {
        var textarea = document.getElementById('SOQLExp');
        var box = document.getElementById('SOQLHighlightBox');
        box.style.top = (textarea.offsetTop + textarea.clientTop) + 'px';
        box.style.left = (textarea.offsetLeft + textarea.clientLeft) + 'px';
        box.style.width = textarea.clientWidth + 'px';
        box.style.height = textarea.clientHeight + 'px';
        document.getElementById('SOQLHighlight').style.transform = 'translate(' + (-textarea.scrollLeft) + 'px,' + (-textarea.scrollTop) + 'px)';
    }

    //textArea functions. source: http://help.dottoro.com/ljtfkhio.php
    function GetSelection (textareaId) {
        var selection = "";

        var textarea = document.getElementById(textareaId);
        if ('selectionStart' in textarea) {
                // check whether some text is selected in the textarea
            if (textarea.selectionStart != textarea.selectionEnd) {
                selection = textarea.value.substring  (textarea.selectionStart, textarea.selectionEnd);
            }
        }
        else {  // Internet Explorer before version 9
            var textRange = document.selection.createRange ();
            var rangeParent = textRange.parentElement ();
            if (rangeParent === textarea) {
                selection = textRange.text;
            }
        }

        if (selection == "") {
            return textarea.value;
        }
        else {
            return selection;
        }
    }
    
    function ModifySelection (textareaId, newText) {
        var textarea = document.getElementById(textareaId);
        if ('selectionStart' in textarea) {
                // check whether some text is selected in the textarea
            if (textarea.selectionStart != textarea.selectionEnd) {
                var updatedText = textarea.value.substring (0, textarea.selectionStart) + 
                    newText +
                    textarea.value.substring (textarea.selectionEnd);
                textarea.value = updatedText;
            } else {
                textarea.value = newText;
            }
        }
        else {  // Internet Explorer before version 9
                // create a range from the current selection
            var textRange = document.selection.createRange ();
                // check whether the selection is within the textarea
            var rangeParent = textRange.parentElement ();
            if (rangeParent === textarea) {
                textRange.text = newText;
            } else {
                textarea.value = newText;
            }
        }
        refreshSOQLHighlight();
    }

    </script>
    

